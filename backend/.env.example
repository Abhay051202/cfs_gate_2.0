DEPLOYMENT_MODE=development
DATABASE_URL=sqlite+pysqlite:///data/gate.db
CAMERAS_FILE=config/cameras.yaml
CAMERA_1_RTSP=
CAMERA_2_RTSP=
CAMERA_3_RTSP=
CAMERA_4_RTSP=
CAMERA_5_RTSP=
CAMERA_6_RTSP=
CAMERA_7_RTSP=
CAMERA_8_RTSP=
# Automatic discovery on directly attached IPv4 networks.
CAMERA_DISCOVERY_ENABLED=true
CAMERA_DISCOVERY_INTERVAL_SECONDS=60
# Shared ONVIF account configured on your cameras (not the PoE switch account).
CAMERA_ONVIF_USERNAME=
CAMERA_ONVIF_PASSWORD=
PIPELINE_ENABLED=false
MODEL_BACKEND=pytorch
MODEL_PATH=models/best.pt
OCR_ENGINE=paddleocr
OCR_FALLBACK_ENGINE=olmocr
PADDLE_OCR_DETECTION_MODEL=PP-OCRv6_medium_det
PADDLE_OCR_RECOGNITION_MODEL=PP-OCRv6_medium_rec
OCR_MODEL_NAME=Qwen/Qwen2-VL-2B-Instruct
OCR_GPU=true
OCR_DOWNLOAD_ENABLED=false
OCR_MODEL_DIRECTORY=models/easyocr
CLASS_ALIASES={"cointainer":"container"}
TARGET_CLASSES=["container","trailer","truck","vehicle"]
OCR_CLASSES=["container","trailer"]
INFERENCE_FPS=3
CONFIDENCE_THRESHOLD=0.35
OCR_MIN_CONFIDENCE=0.6
MIN_TRACK_HITS=3
OCR_CONFIRMATIONS=2
OCR_MAX_ATTEMPTS=4
OCR_INTERVAL_SECONDS=1
OCR_QUEUE_SIZE=8
OCR_SPOOL_MAX_MB=10240
# Occupancy: normalized centroid drift, spatial reassociation and observed clear time.
STATIONARY_DRIFT_THRESHOLD=0.02
STATIONARY_MATCH_IOU=0.45
STATIONARY_SECONDS=1
GATE_CLEAR_SECONDS=7
CLOUD_DISPATCH_GRACE_SECONDS=10
CLOUD_MIN_PROOF_QUALITY=2.5
CROSS_CAMERA_VIEW_WINDOW_SECONDS=8
GATE_OBSERVATION_GAP_SECONDS=2
DEDUP_SECONDS=30
# Same validated container/lane/direction during a queue or tracker reset.
SAME_CONTAINER_EVENT_WINDOW_SECONDS=600
# Local auxiliary truck detector for cameras with configured lane polygons.
PASSAGE_VEHICLE_MODEL_PATH=models/yolov8x.pt
TRACK_TTL_SECONDS=5
SNAPSHOT_DIRECTORY=snapshots
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_MB=2048
CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200"]

# Prosper Smart Yard Cloud Sync
PROSPER_ENABLED=false
PROSPER_API_BASE_URL=http://syapi.prosperassettracking.com
PROSPER_SITE_ID=
PROSPER_API_KEY=
PROSPER_BEARER_TOKEN=
PROSPER_SITE_CODE=
PROSPER_EMAIL=
PROSPER_PASSWORD=
PROSPER_DEVICE_UUID=
