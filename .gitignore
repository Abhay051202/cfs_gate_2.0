# =====================================================================
# GitIgnore for GateVision / AI Video Based Inventory
# =====================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- Environment & Sensitive Credentials ---
.env
!.env.example
*.pem
*.key

# --- Large Model Files & Weights ---
# Do NOT push bulky OLM OCR / Qwen-VL / EasyOCR / Vision-Language models or heavy >100MB weights
models/olm*
models/qwen*
models/easyocr/
**/models/easyocr/**
**/easyocr/**
models/transformers/
*olmocr*
*Qwen*
*qwen2*
huggingface/
.cache/
**/huggingface/**
**/.cache/**
*.pth
*.pt.bak
backend/models/yolov8x.pt
backend/models/yolo11x.pt
# TensorRT & Large ONNX engines
*.engine
*.plan
*.onnx
# Large training runs
runs/
out/

# --- Video Files & Heavy Media (>100MB GitHub limit) ---
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.m4v
*.flv
*.wmv
recordings/
Test_Data/
data/

# --- Runtime Uploads, Snapshots & Event Evidence ---
uploads/*.mp4
uploads/*.avi
uploads/*.mov
uploads/*.mkv
uploads/*.webm
/snapshots/*
!/snapshots/.gitkeep
backend/snapshots/*
!backend/snapshots/.gitkeep
!backend/app/snapshots/
backend/uploads/*.mp4
backend/uploads/*.avi
backend/uploads/*.mov
backend/uploads/*.mkv
backend/uploads/*.webm
backend/uploads/ocr-spool/
**/ocr-spool/**
uploads/ocr-spool/

# --- Scratch, Test Crops & Temporary Images ---
scratch/
scratch_*.py
backend/scratch_*.py
backend/test_spool_status.py
test_spool_status.py
backend/tests/test_targeted_ocr.py
backend/tests/test_dwell.py
backend/tests/test_twin_occupancy.py
feet_*.png
feet_*.jpg
feet_crop_*.jpg
horiz_*.jpg
track6_*.jpg
crop_test.jpg
thresh.jpg
word_*.jpg
*.tmp

# --- Frontend Node & Build Artifacts ---
node_modules/
.angular/
frontend/dist/
frontend/.angular/
frontend/node_modules/

# --- Databases & Logs ---
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- IDEs & OS Files ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Documentation Notes & Agent Logs ---
brain.md
chat.md
CHANGELOG.md
docs/brain.md
docs/chat.md
docs/CHANGELOG.md
*.chat
*.prompt

# --- Archives ---
*.zip
*.tar
*.tar.gz
*.7z
*.rar
ReachStacker*
